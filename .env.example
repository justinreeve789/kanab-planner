APP_NAME=KanabAPI
APP_ENV=$$APP_ENV$$
APP_KEY=$$APP_KEY$$
APP_DEBUG=$$APP_DEBUG$$
APP_URL=$$APP_URL$$

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=$$DB_DATABASE$$
DB_USERNAME=$$DB_USERNAME$$
DB_PASSWORD=$$DB_PASSWORD$$

HORIZON_PATH=monitor

GOOGLE_API_KEY=$GOOGLE_API_KEY$$
MIX_MAPBOX_TOKEN=$$MIX_MAPBOX_TOKEN$$
NPS_API_KEY=$$NPS_API_KEY$$
OCR=googlecloudvision,ocrspace,tesseract
OCRSPACE_API_KEY=$$OCRSPACE_API_KEY$$

GEMINI_API_KEY=$$GEMINI_API_KEY$$
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=$$OPENAI_API_KEY$$
OPENAI_REQUEST_TIMEOUT=90
OPENAI_MODEL=gpt-4o-mini
OPENAI_FINETUNE_MODEL=$$OPENAI_FINETUNE_MODEL$$

CHROMEDRIVER_DOWNLOADS_PATH=/root/Downloads

GOOGLE_CLIENT_ID=$$GOOGLE_CLIENT_ID$$
GOOGLE_CLIENT_SECRET=$$GOOGLE_CLIENT_SECRET$$
# Defaults to APP_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

HIKING_PROJECT_USERNAME=$$HIKING_PROJECT_USERNAME$$
HIKING_PROJECT_PASSWORD=$$HIKING_PROJECT_PASSWORD$$

STADIA_API_KEY=$$STADIA_API_KEY$$
THUNDERFOREST_API_KEY=$$THUNDERFOREST_API_KEY$$

GOOGLE_SERVICE_ENABLED=true
GOOGLE_SERVICE_ACCOUNT_JSON_LOCATION=google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=google-service-account.json

DO_ACCESS_KEY_ID=$$DO_ACCESS_KEY_ID$$
DO_SECRET_ACCESS_KEY=$$DO_SECRET_ACCESS_KEY$$
DO_DEFAULT_REGION=$$DO_DEFAULT_REGION$$
DO_BUCKET=$$DO_BUCKET$$
DO_FOLDER=$$DO_FOLDER$$
DO_CDN_ENDPOINT=https://api.digitalocean.com/v2/cdn/endpoints/
DO_ENDPOINT=$$DO_ENDPOINT$$
DO_USE_PATH_STYLE_ENDPOINT=false
DO_EXPIRE_SIGNED_URLS=15

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=$$MEILISEARCH_HOST$$
MEILISEARCH_KEY=$$MEILISEARCH_KEY$$

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MODEL_CACHE_STORE=itinerary

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_QUEUE=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
