{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ahmadmayahi/php-google-vision": "^1.0",
        "google/apiclient": "^2.0",
        "google/apiclient-services": "^0.316.0",
        "google/cloud-vision": "^1.7",
        "guzzlehttp/guzzle": "^7.2",
        "ivopetkov/html5-dom-document-php": "2.*",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.2",
        "laravel/scout": "^10.4",
        "laravel/socialite": "^5.17",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.16",
        "meilisearch/meilisearch-php": "^1.4",
        "noffily/duckduckgo-images-api": "^1.0",
        "openai-php/laravel": "^0.6.3",
        "pulkitjalan/google-apiclient": "^6.1",
        "roach-php/laravel": "^2.0",
        "spatie/browsershot": "^3.58",
        "spatie/pdf-to-text": "^1.52",
        "symfony/http-client": "^6.3",
        "thiagoalessio/tesseract_ocr": "^2.12"
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0",
        "symfony/panther": "^2.1",
        "zoon/puphpeteer": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
